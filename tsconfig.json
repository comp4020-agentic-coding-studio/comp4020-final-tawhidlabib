{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly (scripts/).
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"]
}
