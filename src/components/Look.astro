---
import { MODES, THEMES, themeOf } from "../lib/theme";

// The colour theme and light/dark mode, on /me ("Look"). It used to sit in
// every page's header, where it was the one control that didn't move a plan
// on; here it's one tap from the avatar, for anyone, profile or not, since
// it lives in this browser's cookies. A plain form without JavaScript.

interface Props {
  /** Its place in /me's staggered entrance. */
  i?: number;
}

const { i = 0 } = Astro.props;
const { theme, mode } = themeOf(Astro.cookies);
---

<section class="card stack look" aria-labelledby="look-h" style={`--i: ${i}`}>
  <div>
    <h2 id="look-h">Look</h2>
    <p class="muted">Hangout's colours in this browser. Everyone else keeps their own.</p>
  </div>
  <form method="post" action="/api/theme" class="stack">
    <input type="hidden" name="back" value="/me" />
    <fieldset>
      <legend>Colour</legend>
      <div class="swatches">
        {
          THEMES.map((t) => (
            <button type="submit" name="theme" value={t.id} data-swatch={t.id} aria-pressed={t.id === theme ? "true" : "false"}>
              <span class="dot" aria-hidden="true" />
              {t.label}
            </button>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend>Mode</legend>
      <div class="modes">
        {
          MODES.map((m) => (
            <button type="submit" name="mode" value={m.id} aria-pressed={m.id === mode ? "true" : "false"}>
              {m.label}
            </button>
          ))
        }
      </div>
    </fieldset>
  </form>
</section>

<style>
  /* beside a taller tile, keep the form under its heading, not spread out */
  .look {
    align-content: start;
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  legend {
    margin-bottom: 0.45rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .swatches,
  .modes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: 0.45rem;
  }

  .modes {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .swatches button {
    justify-content: flex-start;
  }

  button:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--line));
  }

  button[aria-pressed="true"] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  /* the system draws every border alike there: mark the chosen one */
  @media (forced-colors: active) {
    button[aria-pressed="true"] {
      outline: 2px solid Highlight;
      outline-offset: 1px;
    }
  }

  .dot {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
  }

  [data-swatch="sunset"] .dot {
    background: linear-gradient(135deg, #f97316, #e11d48);
  }
  [data-swatch="ocean"] .dot {
    background: linear-gradient(135deg, #2563eb, #0891b2);
  }
  [data-swatch="forest"] .dot {
    background: linear-gradient(135deg, #16a34a, #0d9488);
  }
  [data-swatch="grape"] .dot {
    background: linear-gradient(135deg, #9333ea, #4f46e5);
  }
  [data-swatch="rose"] .dot {
    background: linear-gradient(135deg, #db2777, #9333ea);
  }
</style>

<script>
  // With JS, a choice applies at once instead of reloading the page; the
  // cookie is the same one /api/theme sets, so the next page agrees.
  const form = document.querySelector<HTMLFormElement>(".look form");
  form?.addEventListener("submit", (event) => {
    const button = event.submitter as HTMLButtonElement | null;
    if (!button || (button.name !== "theme" && button.name !== "mode")) return;
    event.preventDefault();
    document.documentElement.dataset[button.name] = button.value;
    const secure = location.protocol === "https:" ? "; secure" : "";
    document.cookie = `${button.name}=${button.value}; path=/; max-age=31536000; samesite=lax${secure}`;
    for (const b of form.querySelectorAll<HTMLButtonElement>(`button[name="${button.name}"]`)) {
      b.setAttribute("aria-pressed", String(b === button));
    }
  });
</script>
