---
// Hangout's mark: three people's free time as overlapping circles, darkest
// where everyone meets. That overlap is the whole product.
---

<svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
  <rect class="logo-tile" width="32" height="32" rx="9"></rect>
  <g class="logo-rings">
    <circle class="ring ring-a" cx="12.5" cy="13" r="6.2"></circle>
    <circle class="ring ring-b" cx="19.5" cy="13" r="6.2"></circle>
    <circle class="ring ring-c" cx="16" cy="19" r="6.2"></circle>
  </g>
</svg>
