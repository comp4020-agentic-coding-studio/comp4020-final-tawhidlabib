---
import Icon from "./Icon.astro";
import EveryStep from "./story/EveryStep.astro";
import HonestWeek from "./story/HonestWeek.astro";
import HowWeKnow from "./story/HowWeKnow.astro";
import LeftOut from "./story/LeftOut.astro";

// After "Start a group", the landing page goes on telling Hangout's story,
// and that story is my README: my tutor, Bill, agreed the landing page can
// be it. Four sections, each standing in for one of README.md's headings
// (README.md links each one by its id):
//   #every-step   what good means: a plan's life, beating the chat each step
//   #honest-week  what I read and looked at: the blind grid, and why
//   #left-out     what I chose not to build, and what that costs
//   #how-we-know  what's enforced, and what's judged (and how)
// Then a footnote that says so and offers the plain text at /readme/.
// spec/landing.test.ts holds the two copies together.
//
// The sections and their cards ease in as they scroll into view, like the
// rest of the page, but every entrance here has finished well before its
// words reach the middle of the screen, so nothing fades while it's read.
// With motion reduced nothing moves: every visual rests on its last frame.
---

<div id="readme" class="story">
  <EveryStep />
  <HonestWeek />
  <LeftOut />
  <HowWeKnow />

  <p class="footnote rise">
    <span class="icon-bubble" aria-hidden="true"><Icon name="sparkles" size={18} /></span>
    <span>
      These sections are also my README for the course, approved by my tutor, Bill. Every source
      is real and checked; the demo groups and chats are made up. Prefer plain text?{" "}
      <a href="/readme/">Read it here <Icon name="arrow" size={16} /></a>
    </span>
  </p>
</div>

<style>
  /* each chapter of the story gets more room than the sections above it */
  .story > :global(section) {
    margin-bottom: clamp(4rem, 9vw, 6.5rem);
  }

  .story :global(.chapter-head) {
    max-width: 40rem;
    margin-bottom: 1.8rem;
  }

  .story :global(.chapter-head h2) {
    margin-bottom: 0.8rem;
    font-size: clamp(1.6rem, 4.2vw, 2.4rem);
    font-weight: 800;
  }

  .story :global(.lead) {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.02rem, 2vw, 1.15rem);
  }

  .footnote {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 44rem;
    margin: 0 auto;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .footnote .icon-bubble {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    margin: 0;
    border-radius: 0.8rem;
  }

  .footnote a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0;
    font-weight: 700;
    white-space: nowrap;
  }

  /* As they scroll in: each chapter fades and rises (the page's .reveal)
     over its first 14rem on screen, not over 28% of its height, which in
     a long chapter was still going when its first words were read. Its
     cards rise in after it, staggered by --i, each done within ~15rem. */
  @supports (animation-timeline: view()) {
    #readme > :global(.reveal) {
      animation-range: cover 0px cover 14rem;
    }
    @media (prefers-reduced-motion: no-preference) {
      .story :global(.rise) {
        animation-name: rise;
        animation-timing-function: var(--ease);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover calc(var(--i, 0) * 1.5rem) cover calc(10rem + var(--i, 0) * 1.5rem);
      }
    }
  }
</style>
