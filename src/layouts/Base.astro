---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/inter";
import "../styles.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { hue, initials } from "../lib/avatar";
import { unansweredCount } from "../lib/events";
import { FLASHES } from "../lib/flash";
import { pendingCount } from "../lib/friends";
import { unreadCount } from "../lib/notify";
import { MODES, THEMES, themeOf } from "../lib/theme";
import { DEFAULT_TIMEZONE, todayIn } from "../lib/time";

interface Props {
  title: string;
}

const { title } = Astro.props;
const { theme, mode } = themeOf(Astro.cookies);
const back = Astro.url.pathname + Astro.url.search;
const toast = Astro.locals.flash ? FLASHES[Astro.locals.flash] : undefined;
const person = Astro.locals.person;
const unread = person ? unreadCount(person.id) : 0;

// The main navigation: which item is this page, and what's waiting in each.
const path = Astro.url.pathname;
const NAV = [
  { key: "home", href: "/", label: "Home", icon: "home", on: path === "/" },
  {
    key: "groups",
    href: "/groups",
    label: "Groups",
    icon: "users",
    on: path.startsWith("/groups") || path.startsWith("/g/"),
  },
  { key: "calendar", href: "/calendar", label: "Calendar", icon: "calendar", on: path.startsWith("/calendar") },
  {
    key: "events",
    href: "/events",
    label: "Events",
    icon: "ticket",
    on: path.startsWith("/events") || path.startsWith("/e/"),
    badge: person ? unansweredCount(person.id, todayIn(person.timezone ?? DEFAULT_TIMEZONE)) : 0,
  },
  {
    key: "friends",
    href: "/friends",
    label: "Friends",
    icon: "heart",
    on: path.startsWith("/friends") || path.startsWith("/f/"),
    badge: person ? pendingCount(person.id) : 0,
  },
] as const;
---

<!doctype html>
<html lang="en-AU" data-theme={theme} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Hangout: tell your friend group when you're free this week, and find the time that works for the most of you."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ea580c" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body data-person={person?.name}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="bar">
        <a href="/" class="brand">
          <Logo />
          <span>Hangout</span>
        </a>
        <nav aria-label="Main" class="main-nav" id="main-nav" data-live={person ? "person:me" : undefined}>
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} class="nav-link" aria-current={item.on ? "page" : undefined}>
                    {item.on && <span class="nav-pill" aria-hidden="true" />}
                    <span class="nav-icon">
                      <Icon name={item.icon} size={20} />
                    </span>
                    <span class="nav-label">{item.label}</span>
                    {"badge" in item && item.badge > 0 && (
                      <span class="badge">
                        <span aria-hidden="true">{item.badge}</span>
                        <span class="vh">, {item.badge} waiting</span>
                      </span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          person && (
            <a
              href="/inbox"
              id="bell"
              class="bell"
              data-live="person:me"
              aria-current={path === "/inbox" ? "page" : undefined}
              aria-label={unread > 0 ? `Inbox, ${unread} unread` : "Inbox"}
            >
              <Icon name="bell" size={20} />
              {unread > 0 && (
                <span class="badge" aria-hidden="true">
                  {unread > 99 ? "99+" : unread}
                </span>
              )}
            </a>
          )
        }
        {
          person ? (
            <a href="/me" class="me-link" aria-current={path === "/me" ? "page" : undefined}>
              <span class="avatar" style={`--hue: ${hue(person.name)}`} aria-hidden="true">
                {initials(person.name)}
              </span>
              <span class="vh">Your profile, {person.name}</span>
            </a>
          ) : (
            <a href="/me" class="button small get-started">
              Get started
            </a>
          )
        }
        <details class="theme-picker">
          <summary>
            <span class="current-dot" aria-hidden="true"></span>
            <span class="theme-word">Theme</span>
          </summary>
          <form method="post" action="/api/theme" class="theme-menu">
            <input type="hidden" name="back" value={back} />
            <fieldset>
              <legend>Colour</legend>
              <div class="swatches">
                {
                  THEMES.map((t) => (
                    <button
                      type="submit"
                      name="theme"
                      value={t.id}
                      data-swatch={t.id}
                      aria-pressed={t.id === theme ? "true" : "false"}
                    >
                      <span class="dot" aria-hidden="true" />
                      {t.label}
                    </button>
                  ))
                }
              </div>
            </fieldset>
            <fieldset>
              <legend>Mode</legend>
              <div class="modes">
                {
                  MODES.map((m) => (
                    <button
                      type="submit"
                      name="mode"
                      value={m.id}
                      aria-pressed={m.id === mode ? "true" : "false"}
                    >
                      {m.label}
                    </button>
                  ))
                }
              </div>
            </fieldset>
          </form>
        </details>
      </div>
    </header>
    {
      toast && (
        <div class="toast" role="status" data-party={toast.party ? "" : undefined}>
          <span class="toast-icon" aria-hidden="true">
            <Icon name={toast.party ? "sparkles" : "check"} size={16} />
          </span>
          {toast.text}
        </div>
      )
    }
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <a href="/" class="brand foot-brand">
        <Logo />
        <span>Hangout</span>
      </a>
      <p>Find the overlap. For small groups who'd rather meet than message.</p>
      <p><a href="/readme/">What good means here</a></p>
    </footer>
  </body>
</html>

<script>
  import "../scripts/live";

  // The picker works as a plain form; with JS, a choice applies instantly
  // instead of reloading the page.
  const picker = document.querySelector<HTMLDetailsElement>("details.theme-picker");
  const menu = picker?.querySelector<HTMLFormElement>("form.theme-menu");
  menu?.addEventListener("submit", (event) => {
    const button = event.submitter as HTMLButtonElement | null;
    if (!button || (button.name !== "theme" && button.name !== "mode")) return;
    event.preventDefault();
    document.documentElement.dataset[button.name] = button.value;
    const secure = location.protocol === "https:" ? "; secure" : "";
    document.cookie = `${button.name}=${button.value}; path=/; max-age=31536000; samesite=lax${secure}`;
    for (const b of menu.querySelectorAll<HTMLButtonElement>(`button[name="${button.name}"]`)) {
      b.setAttribute("aria-pressed", String(b === button));
    }
  });
  // Close on Escape or a click elsewhere, like any menu.
  document.addEventListener("click", (event) => {
    if (picker?.open && !picker.contains(event.target as Node)) picker.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && picker?.open) {
      picker.open = false;
      picker.querySelector("summary")?.focus();
    }
  });

  // ─── the toast a form action left, and confetti for the happy ones ─────
  const toast = document.querySelector<HTMLElement>(".toast");
  if (toast) setTimeout(() => toast.remove(), 5500);
  function confetti() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const box = document.createElement("div");
    box.className = "confetti";
    box.setAttribute("aria-hidden", "true");
    const style = getComputedStyle(document.documentElement);
    const colours = [
      style.getPropertyValue("--accent"),
      style.getPropertyValue("--accent-2"),
      "#facc15",
      "#ffffff",
      "#38bdf8",
    ];
    for (let i = 0; i < 90; i++) {
      const piece = document.createElement("i");
      const set = (k: string, v: string) => piece.style.setProperty(k, v);
      set("--x", `${Math.random() * 100}vw`);
      set("--dx", `${(Math.random() - 0.5) * 30}vw`);
      set("--r", `${(Math.random() - 0.5) * 1080}deg`);
      set("--d", `${Math.random() * 0.5}s`);
      set("--t", `${2.2 + Math.random() * 1.6}s`);
      set("--w", `${0.35 + Math.random() * 0.35}rem`);
      set("--h", `${0.6 + Math.random() * 0.6}rem`);
      set("--c", colours[i % colours.length]);
      box.append(piece);
    }
    document.body.append(box);
    setTimeout(() => box.remove(), 4800);
  }
  if (toast?.hasAttribute("data-party")) setTimeout(confetti, 250);

  // ─── forms that ask first (cancelling an event, say) ──────────────────
  document.addEventListener(
    "submit",
    (event) => {
      const form = event.target as HTMLFormElement;
      if (form.dataset.confirm && !confirm(form.dataset.confirm)) {
        event.preventDefault();
        event.stopImmediatePropagation();
      }
    },
    true,
  );

  // ─── copy and share buttons, anywhere, including parts swapped in live ─
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-copy], [data-share]");
    if (!button) return;
    if (button.dataset.copy !== undefined && navigator.clipboard) {
      await navigator.clipboard.writeText(button.dataset.copy);
      const original = button.innerHTML;
      button.textContent = "Copied ✓";
      setTimeout(() => (button.innerHTML = original), 2000);
    } else if (button.dataset.share !== undefined && "share" in navigator) {
      navigator.share({ title: document.title, url: button.dataset.share }).catch(() => {});
    }
  });
  function enhance(root: ParentNode) {
    if (navigator.clipboard) {
      root.querySelectorAll<HTMLElement>("[data-copy]").forEach((b) => (b.hidden = false));
      // a no-JS fallback link isn't needed once Copy works
      root.querySelectorAll<HTMLElement>("[data-copy-fallback]").forEach((l) => (l.hidden = true));
    }
    if ("share" in navigator) root.querySelectorAll<HTMLElement>("[data-share]").forEach((b) => (b.hidden = false));
  }
  enhance(document);
  document.addEventListener("live:swapped", (e) => enhance((e as CustomEvent<HTMLElement>).detail));
</script>
