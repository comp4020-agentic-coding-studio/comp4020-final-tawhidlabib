---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/inter";
import "../styles.css";
import Avatar from "../components/Avatar.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { unansweredCount } from "../lib/events";
import { FLASHES } from "../lib/flash";
import { pendingCount } from "../lib/friends";
import { unreadCount } from "../lib/notify";
import { themeOf } from "../lib/theme";
import { DEFAULT_TIMEZONE, todayIn } from "../lib/time";

interface Props {
  title: string;
  /** A page whose URL is itself a secret (a sign-in link): its card says
   *  nothing about whose it is, never repeats the URL, and isn't indexed. */
  privateLink?: boolean;
}

const { title, privateLink = false } = Astro.props;
// Hangout spreads by link, and a chat app draws a link's preview card from
// these, fetched as a stranger: the page's own title (an invite already
// names its group, since the link is the invite), never anything private.
const DESCRIPTION =
  "Hangout: tell your friend group when you're free this week, and find the time that works for the most of you.";
const canonical = new URL(privateLink ? "/" : Astro.url.pathname + Astro.url.search, Astro.url).href;
const cardTitle = privateLink ? "Your Hangout sign-in link" : title;
const { theme, mode } = themeOf(Astro.cookies);
// The card's picture (public/og.png, 1200×630: the logo, "Find the overlap"
// and a week with its best time ringed), drawn large above the title. Its
// URL is absolute because the chat app fetches it from elsewhere. A sign-in
// link's card stays the small text-only summary: it's yours, not an invite.
const ogImage = privateLink ? undefined : new URL("/og.png", Astro.url).href;
// The browser's own bar (a phone's status bar, a tab strip) takes the page's
// background, light or dark (--bg in styles.css, the same in every theme).
// A mode picked on /me wins over the system's, as it does for the page;
// data-own keeps each tag's own colour for when the mode goes back to Auto.
const BAR = { light: "#ffffff", dark: "#0d0d10" } as const;
const bar = {
  light: mode === "dark" ? BAR.dark : BAR.light,
  dark: mode === "light" ? BAR.light : BAR.dark,
};
const toast = Astro.locals.flash ? FLASHES[Astro.locals.flash] : undefined;
const person = Astro.locals.person;
const unread = person ? unreadCount(person.id) : 0;

// The main navigation: which item is this page, and what's waiting in each.
const path = Astro.url.pathname;
const NAV = [
  { key: "home", href: "/", label: "Home", icon: "home", on: path === "/" },
  {
    key: "groups",
    href: "/groups",
    label: "Groups",
    icon: "users",
    on: path.startsWith("/groups") || path.startsWith("/g/"),
  },
  { key: "calendar", href: "/calendar", label: "Calendar", icon: "calendar", on: path.startsWith("/calendar") },
  {
    key: "events",
    href: "/events",
    label: "Events",
    icon: "ticket",
    on: path.startsWith("/events") || path.startsWith("/e/"),
    badge: person ? unansweredCount(person.id, todayIn(person.timezone ?? DEFAULT_TIMEZONE)) : 0,
  },
  {
    key: "friends",
    href: "/friends",
    label: "Friends",
    icon: "heart",
    on: path.startsWith("/friends") || path.startsWith("/f/"),
    badge: person ? pendingCount(person.id) : 0,
  },
] as const;
---

<!doctype html>
<html lang="en-AU" data-theme={theme} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hangout" />
    <meta property="og:title" content={cardTitle} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={canonical} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content="Hangout's logo, the words “Find the overlap”, and a week of free hours with Thursday 6 to 9pm ringed as the time everyone shares."
          />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {privateLink && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={bar.light} data-own={BAR.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={bar.dark} data-own={BAR.dark} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body data-person={person?.name}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="bar">
        <a href="/welcome" class="brand">
          <Logo />
          <span>Hangout</span>
        </a>
        <nav aria-label="Main" class="main-nav" id="main-nav" data-live={person ? "person:me" : undefined}>
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} class="nav-link" aria-current={item.on ? "page" : undefined}>
                    {item.on && <span class="nav-pill" aria-hidden="true" />}
                    <span class="nav-icon">
                      <Icon name={item.icon} size={20} />
                    </span>
                    <span class="nav-label">{item.label}</span>
                    {"badge" in item && item.badge > 0 && (
                      <span class="badge">
                        <span aria-hidden="true">{item.badge}</span>
                        <span class="vh">, {item.badge} waiting</span>
                      </span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          person && (
            <a
              href="/inbox"
              id="bell"
              class="bell"
              data-live="person:me"
              aria-current={path === "/inbox" ? "page" : undefined}
              aria-label={unread > 0 ? `Inbox, ${unread} unread` : "Inbox"}
            >
              <Icon name="bell" size={20} />
              {unread > 0 && (
                <span class="badge" aria-hidden="true">
                  {unread > 99 ? "99+" : unread}
                </span>
              )}
            </a>
          )
        }
        {
          person ? (
            <a href="/me" class="me-link" aria-current={path === "/me" ? "page" : undefined}>
              <Avatar name={person.name} photo={person.avatarPhoto} emoji={person.avatarEmoji} />
              <span class="vh">Your profile, {person.name}</span>
            </a>
          ) : (
            <a href="/me" class="button small get-started">
              Get started
            </a>
          )
        }
      </div>
    </header>
    {
      toast && (
        <div class="toast" role="status" data-party={toast.party ? "" : undefined}>
          <span class="toast-icon" aria-hidden="true">
            <Icon name={toast.party ? "sparkles" : "check"} size={16} />
          </span>
          {toast.text}
        </div>
      )
    }
    <p class="conn" id="conn" role="status" aria-live="polite" hidden></p>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <a href="/welcome" class="brand foot-brand">
        <Logo />
        <span>Hangout</span>
      </a>
      <p>Find the overlap. For small groups who'd rather meet than message.</p>
      <p><a href="/readme/">What good means here</a></p>
    </footer>
  </body>
</html>

<script>
  import "../scripts/live";

  // ─── the toast a form action left, and confetti for the happy ones ─────
  const toast = document.querySelector<HTMLElement>(".toast");
  if (toast) setTimeout(() => toast.remove(), 5500);
  function confetti() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const box = document.createElement("div");
    box.className = "confetti";
    box.setAttribute("aria-hidden", "true");
    const style = getComputedStyle(document.documentElement);
    const colours = [
      style.getPropertyValue("--accent"),
      style.getPropertyValue("--accent-2"),
      "#facc15",
      "#ffffff",
      "#38bdf8",
    ];
    for (let i = 0; i < 90; i++) {
      const piece = document.createElement("i");
      const set = (k: string, v: string) => piece.style.setProperty(k, v);
      set("--x", `${Math.random() * 100}vw`);
      set("--dx", `${(Math.random() - 0.5) * 30}vw`);
      set("--r", `${(Math.random() - 0.5) * 1080}deg`);
      set("--d", `${Math.random() * 0.5}s`);
      set("--t", `${2.2 + Math.random() * 1.6}s`);
      set("--w", `${0.35 + Math.random() * 0.35}rem`);
      set("--h", `${0.6 + Math.random() * 0.6}rem`);
      set("--c", colours[i % colours.length]);
      box.append(piece);
    }
    document.body.append(box);
    setTimeout(() => box.remove(), 4800);
  }
  if (toast?.hasAttribute("data-party")) setTimeout(confetti, 250);

  // ─── forms that ask first (cancelling an event, say) ──────────────────
  document.addEventListener(
    "submit",
    (event) => {
      const form = event.target as HTMLFormElement;
      if (form.dataset.confirm && !confirm(form.dataset.confirm)) {
        event.preventDefault();
        event.stopImmediatePropagation();
      }
    },
    true,
  );

  // ─── no double submits on a slow connection ───────────────────────────
  // A form that navigates is sent once: a second submit while the first is
  // on its way is cancelled at once (disabling the button alone is too
  // late --- a quick second press beats it), and the buttons show it's
  // working. Coming back to the page with the back button re-enables it.
  document.addEventListener("submit", (event) => {
    const form = event.target as HTMLFormElement;
    if (event.defaultPrevented || form.matches("[data-thread-form]") || form.method === "get") return;
    if (form.hasAttribute("aria-busy")) {
      event.preventDefault();
      return;
    }
    form.setAttribute("aria-busy", "true");
    const button = (event as SubmitEvent).submitter as HTMLButtonElement | null;
    // disable after the browser has read the pressed button's name and value
    setTimeout(() => {
      form.setAttribute("aria-busy", "true");
      form.querySelectorAll<HTMLButtonElement>("button[type=submit], button:not([type])").forEach((b) => (b.disabled = true));
      button?.classList.add("is-busy");
    });
  });
  addEventListener("pageshow", (event) => {
    if (!event.persisted) return;
    document.querySelectorAll<HTMLFormElement>("form[aria-busy]").forEach((form) => {
      form.removeAttribute("aria-busy");
      form.querySelectorAll<HTMLButtonElement>("button").forEach((b) => {
        b.disabled = false;
        b.classList.remove("is-busy");
      });
    });
  });

  // ─── choosing a file uploads it straight away (album photos, avatars) ──
  document.addEventListener("change", (event) => {
    const input = event.target as HTMLInputElement;
    if (input.matches("[data-autosubmit]") && input.files?.length) input.form?.requestSubmit();
  });

  // ─── copy and share buttons, anywhere, including parts swapped in live ─
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-copy], [data-share]");
    if (!button) return;
    if (button.dataset.copy !== undefined && navigator.clipboard) {
      await navigator.clipboard.writeText(button.dataset.copy);
      const original = button.innerHTML;
      button.textContent = "Copied ✓";
      setTimeout(() => (button.innerHTML = original), 2000);
    } else if (button.dataset.share !== undefined && "share" in navigator) {
      navigator.share({ title: document.title, url: button.dataset.share }).catch(() => {});
    }
  });
  function enhance(root: ParentNode) {
    if (navigator.clipboard) {
      root.querySelectorAll<HTMLElement>("[data-copy]").forEach((b) => (b.hidden = false));
      // a no-JS fallback link isn't needed once Copy works
      root.querySelectorAll<HTMLElement>("[data-copy-fallback]").forEach((l) => (l.hidden = true));
    }
    if ("share" in navigator) root.querySelectorAll<HTMLElement>("[data-share]").forEach((b) => (b.hidden = false));
  }
  enhance(document);
  document.addEventListener("live:swapped", (e) => enhance((e as CustomEvent<HTMLElement>).detail));
</script>
