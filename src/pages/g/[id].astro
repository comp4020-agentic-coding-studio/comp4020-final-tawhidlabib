---
import Icon from "../../components/Icon.astro";
import Memories from "../../components/Memories.astro";
import Thread from "../../components/Thread.astro";
import Base from "../../layouts/Base.astro";
import { hue, initials } from "../../lib/avatar";
import { googleCalendarUrl, hangoutEvent } from "../../lib/calendar";
import { availabilityOn, getGroup, listMembers, pastHangouts, rsvpsFor, upcomingHangouts } from "../../lib/db";
import { ERRORS } from "../../lib/forms";
import { type Relationship, relationship } from "../../lib/friends";
import { currentMember } from "../../lib/identity";
import { adminIdOf, isArchived } from "../../lib/manage";
import { recommend } from "../../lib/recommend";
import { openThread } from "../../lib/talk";
import {
  addDays,
  currentWeekStart,
  dayLabel,
  FIRST_HOUR,
  HOURS,
  hasStarted,
  hourLabel,
  isDate,
  LAST_HOUR,
  relativeDay,
  slotKey,
  spanLabel,
  todayIn,
  weekDates,
  weekStartOf,
} from "../../lib/time";

const group = getGroup(Astro.params.id ?? "");
if (!group) Astro.response.status = 404;

const me = group && currentMember(Astro.cookies, group.id);
const members = group ? listMembers(group.id) : [];
const error = ERRORS[Astro.url.searchParams.get("error") ?? ""];
const inviteUrl = group ? new URL(`/g/${group.id}`, Astro.url).href : "";
const flashed = Astro.locals.flash;

// The week on show: ?week= when it names a Monday, otherwise this week.
const asked = Astro.url.searchParams.get("week") ?? "";
const thisWeek = group ? currentWeekStart(group.timezone) : "";
const week = isDate(asked) && weekStartOf(asked) === asked ? asked : thisWeek;
const dates = group ? weekDates(week) : [];
const today = group ? todayIn(group.timezone) : "";

// Who's free in each hour of the week, by slot key.
const free = new Map<string, Set<number>>();
if (group && me) {
  for (const a of availabilityOn(group.id, dates)) {
    const key = slotKey(a.date, a.hour);
    if (!free.has(key)) free.set(key, new Set());
    free.get(key)?.add(a.memberId);
  }
}
const nameOf = new Map(members.map((m) => [m.id, m.name]));
const others = me ? members.length - 1 : 0;

function cell(date: string, hour: number) {
  const key = slotKey(date, hour);
  const here = free.get(key) ?? new Set<number>();
  const elsewhere = [...here].filter((id) => id !== me?.id);
  const names = elsewhere.map((id) => nameOf.get(id)).join(", ");
  return {
    key,
    mine: me ? here.has(me.id) : false,
    count: elsewhere.length,
    // 0–4: how much of the rest of the group is free then
    heat: others === 0 ? 0 : Math.ceil((elsewhere.length / others) * 4),
    label: `${dayLabel(date)}, ${hourLabel(hour)}. ${
      elsewhere.length ? `Also free: ${names}.` : "Nobody else free yet."
    }`,
  };
}

const namesOf = (ids: number[]) =>
  ids
    .map((id) => (id === me?.id ? "you" : nameOf.get(id)))
    .filter(Boolean)
    .join(", ");
const range = (from: number, to: number) => Array.from({ length: to - from }, (_, i) => from + i);
/** "Tue 8 Jan" → ["Tue", "8"], for the date tiles and grid headers. */
const dayParts = (date: string) => dayLabel(date).split(" ");
/** Where a stretch sits in the grid's day, as fractions for the day bar. */
const DAY = LAST_HOUR + 1 - FIRST_HOUR;
const daybar = (start: number, end: number) =>
  `--from: ${(start - FIRST_HOUR) / DAY}; --len: ${(end - start) / DAY}`;

const best =
  group && me
    ? recommend(members.length, free, dates, (date, hour) => hasStarted(date, hour, group.timezone))
    : [];

const plans = group && me ? upcomingHangouts(group.id, today) : [];
const before = group && me ? pastHangouts(group.id, today) : [];
const answers = rsvpsFor([...plans, ...before].map((p) => p.id));
const past = before.map((plan) => ({
  plan,
  going: answers.filter((a) => a.hangoutId === plan.id && a.response === "in").map((a) => a.memberId),
}));
const hangouts = plans.map((plan) => {
  const mine = answers.filter((a) => a.hangoutId === plan.id);
  return {
    plan,
    going: mine.filter((a) => a.response === "in").map((a) => a.memberId),
    notGoing: mine.filter((a) => a.response === "out").map((a) => a.memberId),
    myAnswer: mine.find((a) => a.memberId === me?.id)?.response,
    google: group ? googleCalendarUrl(hangoutEvent(plan, group, Astro.url.origin)) : "",
  };
});

// running the group: who's admin, and whether it's archived (read-only)
const adminId = group ? adminIdOf(group) : undefined;
const amAdmin = !!me && adminId === me.id;
const archived = group ? isArchived(group) : false;

// The one thing this person should do next, most pressing first.
const markedThisWeek = me ? [...free.values()].some((s) => s.has(me.id)) : false;
const unanswered = hangouts.find((h) => !h.myAnswer);
const goingTo = hangouts.find((h) => h.myAnswer === "in");
const next = archived
  ? ({ kind: "archived" } as const)
  : unanswered
  ? ({ kind: "rsvp", h: unanswered } as const)
  : members.length === 1
    ? ({ kind: "invite" } as const)
    : !markedThisWeek
      ? ({ kind: "mark" } as const)
      : best.length > 0 && hangouts.length === 0
        ? ({ kind: "propose" } as const)
        : goingTo
          ? ({ kind: "going", h: goingTo } as const)
          : ({ kind: "wait" } as const);

// The People tab: how you stand with each member, and everyone's week.
const ties = new Map<number, Relationship>();
if (me?.personId) {
  for (const m of members) {
    if (m.personId !== null) ties.set(m.id, relationship(me.personId, m.personId));
  }
}
const hoursOf = (memberId: number, date: string) =>
  HOURS.filter((h) => free.get(slotKey(date, h))?.has(memberId));
/** "6pm–9pm, 10pm–12am": an hour list as the stretches it makes. */
function stretches(hours: number[]): string {
  const runs: [number, number][] = [];
  for (const h of hours) {
    const last = runs.at(-1);
    if (last && last[1] === h) last[1] = h + 1;
    else runs.push([h, h + 1]);
  }
  return runs.map(([a, b]) => `${hourLabel(a)}–${hourLabel(b)}`).join(", ");
}
const level = (n: number) => (n === 0 ? 0 : n <= 2 ? 1 : n <= 4 ? 2 : n <= 7 ? 3 : 4);
const peopleBack = `/g/${group?.id}?week=${week}#people`;

const TABS = ["week", "best", "plans", "people"];
---

{
  !group ? (
    <Base title="No group here · Hangout">
      <div class="narrow card join-card stack">
        <div class="icon-bubble">
          <Icon name="link" size={22} />
        </div>
        <h1>There's no group at this link</h1>
        <p class="muted">
          The link might be cut short, or mistyped. Ask whoever sent it to copy it again.
        </p>
        <div>
          <a class="button" href="/#start">
            Start a group of your own
            <span class="icon-arrow">
              <Icon name="arrow" />
            </span>
          </a>
        </div>
      </div>
    </Base>
  ) : !me ? (
    <Base title={`Join ${group.name} · Hangout`}>
      <div class="narrow start-card join-card stack">
        <ul class="avatars" aria-hidden="true">
          {members.slice(0, 6).map((m, i) => (
            <li class="avatar" style={`--hue: ${hue(m.name)}; --i: ${i}`}>
              {initials(m.name)}
            </li>
          ))}
        </ul>
        <div>
          <span class="pill">
            <Icon name="sparkles" size={14} /> You're invited
          </span>
          <h1>Join {group.name}</h1>
          <p class="muted">
            {members.length === 1
              ? `${members[0].name} is finding a time to hang out.`
              : `${members.map((m) => m.name).join(", ")} are finding a time to hang out.`}{" "}
            Pick a name they'll recognise, then tap the hours you're free.
          </p>
        </div>
        {error && (
          <p class="error" role="alert">
            {error}
          </p>
        )}
        {Astro.locals.person ? (
          <>
            <form method="post" action={`/api/groups/${group.id}/join`}>
              <input type="hidden" name="name" value={Astro.locals.person.name} />
              <button type="submit" class="button large">
                Join as {Astro.locals.person.name}
                <span class="icon-arrow">
                  <Icon name="arrow" />
                </span>
              </button>
            </form>
            <details class="other-name">
              <summary>Use a different name in this group</summary>
              <form method="post" action={`/api/groups/${group.id}/join`} class="inline-form">
                <label class="vh" for="other-name">
                  Your name in this group
                </label>
                <input type="text" name="name" id="other-name" required maxlength="40" />
                <button type="submit" class="button ghost">
                  Join
                </button>
              </form>
            </details>
          </>
        ) : (
          <>
            <form method="post" action={`/api/groups/${group.id}/join`} class="stack">
              <label class="field">
                Your name
                <input
                  type="text"
                  name="name"
                  required
                  maxlength="40"
                  autocomplete="given-name"
                  placeholder="What your friends call you"
                />
              </label>
              <div>
                <button type="submit" class="button large">
                  Join the group
                  <span class="icon-arrow">
                    <Icon name="arrow" />
                  </span>
                </button>
              </div>
            </form>
            <p class="muted">No account or password. This browser will remember you.</p>
          </>
        )}
      </div>
    </Base>
  ) : (
    <Base title={`${group.name} · Hangout`}>
      <Fragment slot="head">
        {/* Pick the tab before first paint, so the page never flashes every panel. */}
        <script is:inline define:vars={{ tabs: TABS }}>
          document.documentElement.classList.add("js");
          const asked = location.hash.slice(1);
          document.documentElement.dataset.tab = tabs.includes(asked) ? asked : "week";
        </script>
      </Fragment>

      <div class="group-head" id="group-head" data-live={`group:${group.id}`}>
        <div>
          <h1>{group.name}</h1>
          {archived && (
            <p class="archived-note">
              <Icon name="lock" size={14} /> Archived: you can look back, but nothing new can be added.
            </p>
          )}
          <ul class="avatars" aria-label="Members">
            {members.slice(0, 7).map((m) => (
              <li class="avatar" style={`--hue: ${hue(m.name)}`} title={m.name}>
                <span aria-hidden="true">{initials(m.name)}</span>
                <span class="vh">{m.id === me.id ? `${m.name} (you)` : m.name}</span>
              </li>
            ))}
            {members.length > 7 && <li class="more">+{members.length - 7}</li>}
          </ul>
        </div>
        <a class="button ghost small" href="#people">
          <Icon name="users" size={16} /> Invite friends
        </a>
      </div>
      <p class="here-now" data-presence={`group:${group.id}`} hidden />

      {error && (
        <p class="error" role="alert">
          {error}
        </p>
      )}

      <section class="next-step" aria-label="Your next step" id="next-step" data-live={`group:${group.id}`}>
        {next.kind === "archived" ? (
          <div class="what">
            <span class="label">
              <Icon name="lock" size={14} /> Archived
            </span>
            <strong>This group's plans are here to look back on. Nothing new can be added.</strong>
          </div>
        ) : next.kind === "rsvp" ? (
          <>
            <div class="what">
              <span class="label">
                <Icon name="sparkles" size={14} /> Are you in?
              </span>
              <strong>
                {next.h.plan.title}, {spanLabel(next.h.plan.date, next.h.plan.startHour, next.h.plan.endHour)}
              </strong>
            </div>
            <form method="post" action={`/api/hangouts/${next.h.plan.id}/rsvp`} class="rsvp">
              <button type="submit" name="response" value="in" aria-pressed="false">
                <Icon name="check" size={16} /> I'm in
              </button>
              <button type="submit" name="response" value="out" class="out" aria-pressed="false">
                Can't make it
              </button>
            </form>
          </>
        ) : next.kind === "invite" ? (
          <>
            <div class="what">
              <span class="label">
                <Icon name="users" size={14} /> Next step
              </span>
              <strong>Invite your friends. Hangout needs at least two of you.</strong>
            </div>
            <button type="button" class="button" data-copy={inviteUrl} hidden>
              <Icon name="copy" size={18} /> Copy invite link
            </button>
            <a class="button" href="#people" data-copy-fallback>
              Get the invite link
            </a>
          </>
        ) : next.kind === "mark" ? (
          <>
            <div class="what">
              <span class="label">
                <Icon name="grid" size={14} /> Next step
              </span>
              <strong>
                Tap the hours you're free{week === thisWeek ? " this week" : ` in the week of ${dayLabel(week)}`}.
              </strong>
            </div>
            <a class="button" href="#week">
              Mark my hours
              <span class="icon-arrow">
                <Icon name="arrow" size={18} />
              </span>
            </a>
          </>
        ) : next.kind === "propose" ? (
          <>
            <div class="what">
              <span class="label">
                <Icon name="sparkles" size={14} /> Best time found
              </span>
              <strong>
                {spanLabel(best[0].date, best[0].start, best[0].end)} · {best[0].people.length} of{" "}
                {members.length} free
              </strong>
            </div>
            <a class="button" href="#best">
              Propose it
              <span class="icon-arrow">
                <Icon name="arrow" size={18} />
              </span>
            </a>
          </>
        ) : next.kind === "going" ? (
          <>
            <div class="what">
              <span class="label">
                <Icon name="check" size={14} /> You're in
              </span>
              <strong>
                {next.h.plan.title}, {spanLabel(next.h.plan.date, next.h.plan.startHour, next.h.plan.endHour)}
              </strong>
            </div>
            <a class="button" href={next.h.google} target="_blank" rel="noopener">
              <Icon name="calendar" size={18} /> Add to Google Calendar
            </a>
          </>
        ) : (
          <>
            <div class="what">
              <span class="label">
                <Icon name="clock" size={14} /> Waiting on the group
              </span>
              <strong>Recommendations appear once someone else's free hours overlap yours.</strong>
            </div>
            <a class="button ghost" href="#people">
              <Icon name="share" size={18} /> Nudge them with the link
            </a>
          </>
        )}
      </section>

      <nav class="tabs" aria-label="Group sections" data-tabs>
        <a href="#week" data-tab="week">
          <Icon name="grid" size={17} /> Your week
        </a>
        <a href="#best" data-tab="best">
          <Icon name="sparkles" size={17} /> Best times
          {best.length > 0 && <span class="count">{best.length}</span>}
        </a>
        <a href="#plans" data-tab="plans">
          <Icon name="calendar" size={17} /> Hangouts
          {hangouts.length > 0 && <span class="count">{hangouts.length}</span>}
        </a>
        <a href="#people" data-tab="people">
          <Icon name="users" size={17} /> People
          <span class="count">{members.length}</span>
        </a>
      </nav>

      <section id="week" class="panel" aria-labelledby="week-heading">
        <div class="panel-head">
          <h2 id="week-heading">When are you free?</h2>
          {!archived && (
            <form method="post" action={`/api/groups/${group.id}/copy-week`} class="copy-week">
              <input type="hidden" name="week" value={week} />
              <button type="submit" class="button small ghost">
                <Icon name="copy" size={15} /> Copy last week
              </button>
            </form>
          )}
          <nav class="week-nav" aria-label="Week">
            <a href={`?week=${addDays(week, -7)}#week`} aria-label="Earlier week">
              <Icon name="chevronLeft" size={18} />
            </a>
            <strong>{week === thisWeek ? "This week" : `Week of ${dayLabel(week)}`}</strong>
            <a href={`?week=${addDays(week, 7)}#week`} aria-label="Later week">
              <Icon name="chevronRight" size={18} />
            </a>
          </nav>
        </div>
        <p class="muted">
          Tap every hour you could hang out{" "}
          <span class="desktop-hint">(or drag across them)</span>, then save. Times are in{" "}
          {group.timezone}.
        </p>

        <form method="post" action={`/api/groups/${group.id}/availability`}>
          <input type="hidden" name="week" value={week} />
          <div class="card grid-card" id="week-grid" data-live={`group:${group.id}`} data-live-grid>
            <table class="week">
              <caption class="vh">
                Your free hours, week of {dayLabel(week)}
              </caption>
              <thead>
                <tr>
                  <td />
                  {dates.map((date) => {
                    const [weekday, day] = dayParts(date);
                    return (
                      <th scope="col" aria-current={date === today ? "date" : undefined}>
                        {weekday}
                        <span>{day}</span>
                      </th>
                    );
                  })}
                </tr>
              </thead>
              <tbody>
                {HOURS.map((hour) => (
                  <tr>
                    <th scope="row">{hourLabel(hour)}</th>
                    {dates.map((date) => {
                      const c = cell(date, hour);
                      return (
                        <td>
                          <label class="slot" data-heat={c.heat}>
                            <input type="checkbox" name="slot" value={c.key} checked={c.mine} disabled={archived} />
                            <span class="vh">{c.label}</span>
                            <span aria-hidden="true">{c.count > 0 ? c.count : ""}</span>
                          </label>
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="legend" aria-hidden="true">
            <span>
              <span
                class="key"
                style="box-shadow: inset 0 0 0 2.5px var(--accent); background: var(--surface-2)"
              />
              Your hours
            </span>
            <span>
              <span class="scale">
                <i style="background: var(--heat-1)" />
                <i style="background: var(--heat-2)" />
                <i style="background: var(--heat-3)" />
                <i style="background: var(--heat-4)" />
              </span>
              More of the group free (the number is how many)
            </span>
          </div>
          <div class="save-bar">
            <span role="status" id="save-status">
              {flashed === "saved" ? "Saved ✓" : ""}
            </span>
            <button type="submit" class="button" disabled={archived}>
              <Icon name="check" size={18} /> Save my hours
            </button>
          </div>
        </form>
      </section>

      <section id="best" class="panel" aria-labelledby="best-heading">
        <div class="panel-head">
          <h2 id="best-heading">Best times</h2>
          <span class="pill">{week === thisWeek ? "This week" : `Week of ${dayLabel(week)}`}</span>
        </div>
        <div id="best-body" data-live={`group:${group.id}`}>
        {best.length === 0 ? (
          <div class="empty">
            <div class="icon-bubble">
              <Icon name="sparkles" size={22} />
            </div>
            <strong>No overlap yet</strong>
            <span>
              Recommendations appear once at least two of you have marked the same hours.{" "}
              <a href="#week">Mark yours</a>.
            </span>
          </div>
        ) : (
          <div class="cards stagger">
            {best.map((rec, i) => {
              const [weekday, day] = dayParts(rec.date);
              return (
                <div class={`card ${i === 0 ? "best-card" : ""}`} style={`--i: ${i}`}>
                  <div class="when">
                    <div class="date-tile" aria-hidden="true">
                      <small>{weekday}</small>
                      <b>{day}</b>
                    </div>
                    <div>
                      <p class="time">{spanLabel(rec.date, rec.start, rec.end)}</p>
                      <p class="who">
                        {rec.people.length === members.length
                          ? "Everyone's free"
                          : `${rec.people.length} of ${members.length} free`}
                        : {namesOf(rec.people)}
                      </p>
                    </div>
                    {i === 0 && (
                      <span class="pill solid rank">
                        <Icon name="sparkles" size={13} /> Best
                      </span>
                    )}
                  </div>
                  <div class="daybar" aria-hidden="true">
                    <span style={daybar(rec.start, rec.end)} />
                  </div>
                  <div class="daybar-labels" aria-hidden="true">
                    <span>{hourLabel(FIRST_HOUR)}</span>
                    <span>{rec.end - rec.start} hours</span>
                    <span>{hourLabel(LAST_HOUR + 1)}</span>
                  </div>
                  <form method="post" action={`/api/groups/${group.id}/hangouts`} class="propose">
                    <input type="hidden" name="date" value={rec.date} />
                    <label class="field" for={`start-${i}`}>
                      From
                      <select name="start" id={`start-${i}`}>
                        {range(rec.start, rec.end).map((h) => (
                          <option value={h} selected={h === rec.start}>
                            {hourLabel(h)}
                          </option>
                        ))}
                      </select>
                    </label>
                    <label class="field" for={`end-${i}`}>
                      Until
                      <select name="end" id={`end-${i}`}>
                        {range(rec.start + 1, rec.end + 1).map((h) => (
                          <option value={h} selected={h === rec.end}>
                            {hourLabel(h)}
                          </option>
                        ))}
                      </select>
                    </label>
                    <label class="field title-field" for={`title-${i}`}>
                      What's the plan?
                      <input
                        type="text"
                        name="title"
                        id={`title-${i}`}
                        maxlength="80"
                        placeholder="Dinner, a walk, board games…"
                      />
                    </label>
                    <button type="submit" class="button" disabled={archived}>
                      Propose
                    </button>
                  </form>
                </div>
              );
            })}
          </div>
        )}
        </div>
      </section>

      <section id="plans" class="panel" aria-labelledby="plans-heading">
        <div class="panel-head">
          <h2 id="plans-heading">Hangouts</h2>
        </div>
        <div id="plans-body" data-live={`group:${group.id}`}>
        {hangouts.length === 0 ? (
          <div class="empty">
            <div class="icon-bubble">
              <Icon name="calendar" size={22} />
            </div>
            <strong>Nothing planned yet</strong>
            <span>
              Pick one of the <a href="#best">best times</a> and propose it. Everyone gets asked
              if they're in.
            </span>
          </div>
        ) : (
          <div class="cards stagger">
            {hangouts.map(({ plan, going, notGoing, myAnswer, google }, i) => {
              const [weekday, day] = dayParts(plan.date);
              return (
                <article class="card" style={`--i: ${i}`}>
                  <div class="when">
                    <div class="date-tile" aria-hidden="true">
                      <small>{weekday}</small>
                      <b>{day}</b>
                    </div>
                    <div>
                      <p class="time">{spanLabel(plan.date, plan.startHour, plan.endHour)}</p>
                      <p class="plan-title">{plan.title}</p>
                    </div>
                    <span class="pill soon">
                      <Icon name="clock" size={13} /> {relativeDay(plan.date, today)}
                    </span>
                  </div>
                  <div class="going">
                    {going.length === 0 && <span class="muted">Nobody's in yet.</span>}
                    {going.map((id) => (
                      <span class="pill">
                        <Icon name="check" size={13} /> {id === me.id ? "You" : nameOf.get(id)}
                      </span>
                    ))}
                    {notGoing.map((id) => (
                      <span class="pill out">
                        <span class="vh">Can't make it:</span>
                        {id === me.id ? "You" : nameOf.get(id)}
                      </span>
                    ))}
                  </div>
                  <form method="post" action={`/api/hangouts/${plan.id}/rsvp`} class="rsvp">
                    <button
                      type="submit"
                      name="response"
                      value="in"
                      aria-pressed={myAnswer === "in" ? "true" : "false"}
                      disabled={archived}
                    >
                      <Icon name="check" size={16} /> I'm in
                    </button>
                    <button
                      type="submit"
                      name="response"
                      value="out"
                      class="out"
                      aria-pressed={myAnswer === "out" ? "true" : "false"}
                      disabled={archived}
                    >
                      Can't make it
                    </button>
                  </form>
                  {myAnswer === "in" && (
                    <div class="cal-links">
                      <a class="button small" href={google} target="_blank" rel="noopener">
                        <Icon name="calendar" size={16} /> Add to Google Calendar
                      </a>
                      <a class="button small ghost" href={`/api/hangouts/${plan.id}.ics`}>
                        Download .ics
                      </a>
                    </div>
                  )}
                  {(() => {
                    const talk = openThread("hangout", String(plan.id), Astro.cookies);
                    return (
                      talk && (
                        <>
                          {talk.arrived && <Memories thread={talk} />}
                          <Thread thread={talk} compact />
                        </>
                      )
                    );
                  })()}
                </article>
              );
            })}
          </div>
        )}
        {past.length > 0 && (
          <div class="past">
            <h3 class="list-label">Past</h3>
            <div class="cards">
              {past.map(({ plan, going }) => {
                const [weekday, day] = dayParts(plan.date);
                const talk = openThread("hangout", String(plan.id), Astro.cookies);
                return (
                  <article class="card past-card">
                    <div class="when">
                      <div class="date-tile" aria-hidden="true">
                        <small>{weekday}</small>
                        <b>{day}</b>
                      </div>
                      <div>
                        <p class="time">{spanLabel(plan.date, plan.startHour, plan.endHour)}</p>
                        <p class="plan-title">{plan.title}</p>
                        <p class="who">{going.length ? `${namesOf(going)} went` : "Nobody said they were in"}</p>
                      </div>
                    </div>
                    {talk && (
                      <>
                        <Memories thread={talk} />
                        <Thread thread={talk} compact />
                      </>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        )}
        </div>
      </section>

      <section id="people" class="panel" aria-labelledby="people-heading">
        <div class="panel-head">
          <h2 id="people-heading">People</h2>
          <span class="pill">{week === thisWeek ? "This week" : `Week of ${dayLabel(week)}`}</span>
        </div>
        <div id="people-body" data-live={`group:${group.id}`}>
        <div class="stack">
          <div class="card everyone-card">
            <h3>Everyone's week</h3>
            <p class="muted fine">
              Hours each person has marked free. Hover or focus a day to see when.
            </p>
            <div class="table-scroll">
              <table class="everyone">
                <caption class="vh">
                  Hours each member marked free, week of {dayLabel(week)}
                </caption>
                <thead>
                  <tr>
                    <th scope="col">
                      <span class="vh">Member</span>
                    </th>
                    {dates.map((date) => {
                      const [weekday, day] = dayParts(date);
                      return (
                        <th scope="col" aria-current={date === today ? "date" : undefined}>
                          {weekday}
                          <span>{day}</span>
                        </th>
                      );
                    })}
                    <th scope="col">Total</th>
                  </tr>
                </thead>
                <tbody>
                  {members.map((m) => {
                    const total = dates.reduce((n, d) => n + hoursOf(m.id, d).length, 0);
                    return (
                      <tr>
                        <th scope="row">
                          <span class="avatar" style={`--hue: ${hue(m.name)}`} aria-hidden="true">
                            {initials(m.name)}
                          </span>
                          <span class="member-name">
                            {m.name}
                            {m.id === me.id && <span class="muted"> (you)</span>}
                          </span>
                          {total === 0 && m.id !== me.id && m.personId !== null && me.personId !== null && !archived && (
                            <form method="post" action={`/api/groups/${group.id}/nudge`} class="nudge">
                              <input type="hidden" name="member" value={m.id} />
                              <input type="hidden" name="week" value={week} />
                              <button type="submit" class="link-button" aria-label={`Nudge ${m.name} to mark their hours`}>
                                Nudge
                              </button>
                            </form>
                          )}
                        </th>
                        {dates.map((date) => {
                          const hours = hoursOf(m.id, date);
                          const when = hours.length ? stretches(hours) : "Not free";
                          return (
                            <td title={when}>
                              <span class="day-dot" data-level={level(hours.length)} aria-hidden="true">
                                {hours.length || ""}
                              </span>
                              <span class="vh">{when}</span>
                            </td>
                          );
                        })}
                        <td class="total">{total}h</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>

          <div class="card">
            <h3>Members</h3>
            {!me.personId && (
              <p class="hint">
                <a href="/me">Make your profile</a> to add people from this group as friends.
              </p>
            )}
            <ul class="people-grid">
              {members.map((m) => {
                const tie = ties.get(m.id);
                return (
                  <li class="person-row" data-member={m.id}>
                    <span class="avatar md" style={`--hue: ${hue(m.name)}`} aria-hidden="true">
                      {initials(m.name)}
                    </span>
                    <span class="who-name">
                      <b>
                        {m.name}
                        {m.id === adminId && <span class="pill admin">Admin</span>}
                      </b>
                      <span class="muted">
                        {m.id === me.id
                          ? "You"
                          : tie === "friends"
                            ? "Friends"
                            : tie === "sent"
                              ? "Friend request sent"
                              : tie === "received"
                                ? "Wants to be friends"
                                : m.personId === null
                                  ? "Hasn't made a profile yet"
                                  : "In this group"}
                      </span>
                    </span>
                    {tie === "none" && m.id !== me.id && (
                      <form method="post" action="/api/friends" class="row-actions">
                        <input type="hidden" name="person" value={m.personId} />
                        <input type="hidden" name="back" value={peopleBack} />
                        <button type="submit" class="button small ghost">
                          <Icon name="userPlus" size={16} /> Add friend
                        </button>
                      </form>
                    )}
                    {tie === "received" && (
                      <form method="post" action="/api/friends/respond" class="row-actions">
                        <input type="hidden" name="person" value={m.personId} />
                        <input type="hidden" name="back" value={peopleBack} />
                        <button type="submit" name="action" value="accept" class="button small">
                          <Icon name="check" size={16} /> Accept
                        </button>
                      </form>
                    )}
                    {tie === "friends" && (
                      <span class="pill">
                        <Icon name="heart" size={13} /> Friends
                      </span>
                    )}
                    {amAdmin && m.id !== me.id && (
                      <details class="member-menu">
                        <summary aria-label={`Manage ${m.name}`}>⋯</summary>
                        <div class="member-menu-body">
                          <form method="post" action={`/api/groups/${group.id}/manage`}>
                            <input type="hidden" name="action" value="admin" />
                            <input type="hidden" name="member" value={m.id} />
                            <button type="submit">Make admin</button>
                          </form>
                          <form
                            method="post"
                            action={`/api/groups/${group.id}/manage`}
                            data-confirm={`Remove ${m.name} from ${group.name}? They won't be able to rejoin by the link.`}
                          >
                            <input type="hidden" name="action" value="remove" />
                            <input type="hidden" name="member" value={m.id} />
                            <button type="submit" class="danger-text">
                              Remove from group
                            </button>
                          </form>
                        </div>
                      </details>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>

          <div class="start-card stack">
            <div class="split">
              <div class="icon-bubble">
                <Icon name="link" size={22} />
              </div>
              <div>
                <label class="field" for="invite">
                  Invite link: anyone with it can join
                </label>
                <p class="muted fine">
                  Hangout picks the longest stretch the most people share. Times are in{" "}
                  {group.timezone}.
                </p>
              </div>
            </div>
            <div class="invite-row">
              <input type="url" readonly value={inviteUrl} id="invite" />
              <button type="button" class="button" data-copy={inviteUrl} hidden>
                <Icon name="copy" size={18} /> Copy
              </button>
              <button type="button" class="button ghost" data-share={inviteUrl} hidden>
                <Icon name="share" size={18} /> Share
              </button>
            </div>
          </div>

          {amAdmin && (
            <div class="card stack" id="settings">
              <h3>Group settings</h3>
              <p class="muted fine">You're the admin.</p>
              <form method="post" action={`/api/groups/${group.id}/manage`} class="inline-form">
                <input type="hidden" name="action" value="rename" />
                <label class="vh" for="group-name">
                  Group name
                </label>
                <input type="text" name="name" id="group-name" required maxlength="60" value={group.name} />
                <button type="submit" class="button ghost">
                  Rename
                </button>
              </form>
              <form method="post" action={`/api/groups/${group.id}/manage`}>
                <input type="hidden" name="action" value={archived ? "unarchive" : "archive"} />
                <button type="submit" class="button small ghost">
                  <Icon name="lock" size={15} /> {archived ? "Unarchive the group" : "Archive the group (read-only)"}
                </button>
              </form>
            </div>
          )}

          <form
            method="post"
            action={`/api/groups/${group.id}/manage`}
            data-confirm={`Leave ${group.name}?${amAdmin ? " The longest-standing member becomes admin." : ""}`}
          >
            <input type="hidden" name="action" value="leave" />
            <button type="submit" class="button small ghost danger">
              Leave this group
            </button>
          </form>
        </div>
        </div>
      </section>
    </Base>
  )
}

<script>
  // Enhancements only: without JS the tabs are links to sections on one page
  // and every form still submits.
  const root = document.documentElement;

  // ─── tabs, with an indicator that slides between them ──────────────────
  const tablist = document.querySelector<HTMLElement>("[data-tabs]");
  const tabs = [...(tablist?.querySelectorAll<HTMLAnchorElement>("a[data-tab]") ?? [])];
  const names = tabs.map((t) => t.dataset.tab ?? "");
  const indicator = document.createElement("span");
  indicator.className = "tab-indicator";
  indicator.setAttribute("aria-hidden", "true");
  if (tablist) {
    tablist.setAttribute("role", "tablist");
    tablist.prepend(indicator);
    tablist.classList.add("has-indicator");
    for (const tab of tabs) {
      const name = tab.dataset.tab ?? "";
      tab.id = `tab-${name}`;
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", name);
      const panel = document.getElementById(name);
      panel?.setAttribute("role", "tabpanel");
      panel?.setAttribute("aria-labelledby", tab.id);
    }
  }
  const slide = () => {
    const on = tabs.find((t) => t.dataset.tab === root.dataset.tab);
    if (!on) return;
    indicator.style.width = `${on.offsetWidth}px`;
    indicator.style.transform = `translateX(${on.offsetLeft}px)`;
  };
  function select(name: string, { focus = false, remember = true } = {}) {
    if (!names.includes(name)) return;
    root.dataset.tab = name;
    for (const tab of tabs) {
      const on = tab.dataset.tab === name;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on) {
        if (focus) tab.focus();
        tab.scrollIntoView({ block: "nearest", inline: "nearest" });
      }
    }
    slide();
    if (remember) history.replaceState(null, "", `${location.pathname}${location.search}#${name}`);
    // keep the tabs in view when switching from far down a long panel
    if (tablist && tablist.getBoundingClientRect().top > 90) return;
    document.getElementById(name)?.scrollIntoView({ block: "start" });
  }
  if (tablist) {
    select(root.dataset.tab ?? "week", { remember: false });
    // place the indicator without animating it on load
    indicator.style.transition = "none";
    slide();
    requestAnimationFrame(() => (indicator.style.transition = ""));
    addEventListener("resize", slide);
    document.fonts?.ready.then(slide);
  }
  tablist?.addEventListener("keydown", (event) => {
    const at = names.indexOf(root.dataset.tab ?? "");
    const to =
      event.key === "ArrowRight"
        ? (at + 1) % names.length
        : event.key === "ArrowLeft"
          ? (at - 1 + names.length) % names.length
          : event.key === "Home"
            ? 0
            : event.key === "End"
              ? names.length - 1
              : -1;
    if (to < 0) return;
    event.preventDefault();
    select(names[to], { focus: true });
  });
  // Any link to a tab's section (the tabs themselves, the next-step button,
  // "Mark yours") switches tabs instead of jumping.
  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    const name = link?.getAttribute("href")?.slice(1) ?? "";
    if (!link || !names.includes(name)) return;
    event.preventDefault();
    select(name, { focus: link.closest("[data-tabs]") !== null });
  });
  addEventListener("hashchange", () => select(location.hash.slice(1), { remember: false }));

  // ─── the week grid ─────────────────────────────────────────────────────
  const grid = document.querySelector<HTMLTableElement>("table.week");
  const status = document.querySelector<HTMLElement>("#save-status");
  const gridForm = grid?.closest("form");
  // With JS the grid saves itself a moment after you stop tapping, so the
  // rest of the group sees your hours fill in live (crit 9). The Save button
  // stays for anyone without JS, and as a retry.
  let saveTimer = 0;
  async function save() {
    if (!gridForm) return;
    const data = new FormData(gridForm);
    data.set("quiet", "1");
    try {
      const res = await fetch(gridForm.action, { method: "POST", body: data, redirect: "manual" });
      const ok = res.type === "opaqueredirect" || res.ok;
      if (status) status.textContent = ok ? "Saved ✓ · your group sees it live" : "Couldn't save. Press Save to retry";
    } catch {
      if (status) status.textContent = "Offline? Press Save to retry";
    }
  }
  const changed = () => {
    if (status) status.textContent = "Saving…";
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(save, 450);
  };
  grid?.addEventListener("change", changed);
  // from here on, ticking an hour pops (but the page load doesn't)
  requestAnimationFrame(() => root.classList.add("ready"));

  // With a mouse, drag across hours to paint them all the way the first one
  // is going. A plain click still toggles natively; touch keeps plain taps,
  // so the grid still scrolls on a phone.
  const boxIn = (target: EventTarget | null) =>
    (target as Element | null)?.closest(".slot")?.querySelector<HTMLInputElement>("input");
  let first: HTMLInputElement | null = null;
  let painting = false;
  let dragged = false;
  grid?.addEventListener("pointerdown", (event) => {
    const box = boxIn(event.target);
    if (event.pointerType !== "mouse" || !box) return;
    first = box;
    painting = !box.checked;
    dragged = false;
  });
  grid?.addEventListener("pointerover", (event) => {
    const box = boxIn(event.target);
    if (!first || !box || box === first) return;
    dragged = true;
    for (const b of [first, box]) {
      if (b.checked !== painting) {
        b.checked = painting;
        changed();
      }
    }
  });
  // After a drag, a stray click must not toggle the last hour back.
  grid?.addEventListener("click", (event) => {
    if (dragged && boxIn(event.target)) event.preventDefault();
  });
  addEventListener("pointerup", () => {
    first = null;
    setTimeout(() => (dragged = false));
  });
</script>
