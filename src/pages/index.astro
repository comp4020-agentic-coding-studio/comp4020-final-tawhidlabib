---
import Dashboard from "../components/Dashboard.astro";
import Landing from "../components/Landing.astro";
import Base from "../layouts/Base.astro";

// Home: your dashboard once you have a profile, the landing page before.
const person = Astro.locals.person;
---

<Base title={person ? "Home · Hangout" : "Hangout: find the overlap"}>
  {person ? <Dashboard person={person} /> : <Landing />}
</Base>
