---
import EventCard from "../components/EventCard.astro";
import Icon from "../components/Icon.astro";
import Onboard from "../components/Onboard.astro";
import Base from "../layouts/Base.astro";
import { eventsFor, goingCounts, publicEvents, takenCounts } from "../lib/events";
import { addDays, DEFAULT_TIMEZONE, todayIn } from "../lib/time";

const person = Astro.locals.person;
const today = todayIn(person?.timezone ?? DEFAULT_TIMEZONE);
const mine = person ? eventsFor(person.id, today) : [];
const waiting = mine.filter((e) => e.response === "invited" && e.event.hostId !== person?.id);
const rest = mine.filter((e) => !waiting.includes(e));
const search = (Astro.url.searchParams.get("q") ?? "").slice(0, 60);
// Explore's date filters, in your timezone: today, this weekend, the next 7 days
const WHEN = { all: "Any time", today: "Today", weekend: "This weekend", week: "Next 7 days" } as const;
const askedWhen = Astro.url.searchParams.get("when") ?? "all";
const when = (askedWhen in WHEN ? askedWhen : "all") as keyof typeof WHEN;
const dow = (new Date(`${today}T00:00:00Z`).getUTCDay() + 6) % 7; // Monday is 0
const range: [string, string | undefined] =
  when === "today"
    ? [today, today]
    : when === "weekend"
      ? [dow >= 5 ? today : addDays(today, 5 - dow), addDays(today, 6 - dow)]
      : when === "week"
        ? [today, addDays(today, 6)]
        : [today, undefined];
const explore = publicEvents(range[0], 30, search, range[1]);
const ids = [...mine.map((e) => e.event.id), ...explore.map((e) => e.id)];
const going = goingCounts(ids);
const taken = takenCounts(ids);
const filterHref = (w: string) =>
  `/events?${new URLSearchParams({ ...(w === "all" ? {} : { when: w }), ...(search ? { q: search } : {}) })}#explore`;
---

<Base title="Events · Hangout">
  <div class="page-head">
    <div>
      <span class="kicker">What's on</span>
      <h1>Events</h1>
    </div>
    <div class="actions">
      <a class="button" href="/events/new">
        <Icon name="plus" size={18} /> Create event
      </a>
    </div>
  </div>

  <nav class="segmented" aria-label="Event lists">
    <a href="#yours">Your events</a>
    <a href="#explore">Explore</a>
  </nav>

  <section id="yours" class="section" aria-labelledby="yours-h" data-live={person ? "person:me" : undefined}>
    <h2 id="yours-h">Your events</h2>
    {
      !person ? (
        <Onboard back="/events" lead="Make your profile to host events and get invited to them." />
      ) : mine.length === 0 ? (
        <div class="empty">
          <div class="icon-bubble">
            <Icon name="ticket" size={22} />
          </div>
          <strong>Nothing coming up</strong>
          <span>
            <a href="/events/new">Host something</a>, or find a public event below.
          </span>
        </div>
      ) : (
        <div class="stack">
          {waiting.length > 0 && (
            <div>
              <h3 class="list-label">Waiting for your answer</h3>
              <div class="cards stagger">
                {waiting.map(({ event, response }, i) => (
                  <EventCard
                    event={event}
                    today={today}
                    response={response}
                    going={going.get(event.id)}
                    taken={taken.get(event.id)}
                    i={i}
                  />
                ))}
              </div>
            </div>
          )}
          {rest.length > 0 && (
            <div>
              {waiting.length > 0 && <h3 class="list-label">Coming up</h3>}
              <div class="cards stagger">
                {rest.map(({ event, response }, i) => (
                  <EventCard
                    event={event}
                    today={today}
                    response={response}
                    hosting={event.hostId === person.id}
                    going={going.get(event.id)}
                    taken={taken.get(event.id)}
                    i={i}
                  />
                ))}
              </div>
            </div>
          )}
        </div>
      )
    }
  </section>

  <section id="explore" class="section" aria-labelledby="explore-h">
    <h2 id="explore-h">Explore</h2>
    <form method="get" action="/events#explore" class="search">
      <label class="vh" for="q">Search public events</label>
      <input type="search" name="q" id="q" value={search} placeholder="Search by name or place" />
      {when !== "all" && <input type="hidden" name="when" value={when} />}
      <button type="submit" class="button small">Search</button>
    </form>
    <nav class="chips" aria-label="When">
      {
        Object.entries(WHEN).map(([key, label]) => (
          <a href={filterHref(key)} aria-current={key === when ? "true" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <p class="muted">
      {search ? `Public events matching "${search}".` : "Public events anyone can join."}
    </p>
    {
      explore.length === 0 ? (
        <div class="empty">
          <div class="icon-bubble">
            <Icon name="globe" size={22} />
          </div>
          <strong>No public events yet</strong>
          <span>
            Be the first: <a href="/events/new">host one</a> and make it public.
          </span>
        </div>
      ) : (
        <div class="cards stagger">
          {explore.map((event, i) => (
            <EventCard event={event} today={today} going={going.get(event.id)} taken={taken.get(event.id)} i={i} />
          ))}
        </div>
      )
    }
  </section>
</Base>
