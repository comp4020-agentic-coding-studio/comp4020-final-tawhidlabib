---
import Icon from "../../components/Icon.astro";
import Onboard from "../../components/Onboard.astro";
import Base from "../../layouts/Base.astro";
import { hue, initials } from "../../lib/avatar";
import { friendsOf } from "../../lib/friends";
import { ERRORS } from "../../lib/forms";
import { groupsFor } from "../../lib/identity";
import { addDays, DEFAULT_TIMEZONE, todayIn } from "../../lib/time";

const person = Astro.locals.person;
const error = ERRORS[Astro.url.searchParams.get("error") ?? ""];
const friends = person ? friendsOf(person.id) : [];
const groups = person ? groupsFor(person, Astro.request.headers.get("cookie")) : [];
const today = todayIn(person?.timezone ?? DEFAULT_TIMEZONE);
---

<Base title="Create an event · Hangout">
  <div class="page-head">
    <div>
      <span class="kicker">Host something</span>
      <h1>Create an event</h1>
    </div>
  </div>

  {
    !person ? (
      <Onboard back="/events/new" lead="Make your profile, then host your first event." />
    ) : (
      <form method="post" action="/api/events" class="event-form">
        {error && (
          <p class="error" role="alert">
            {error}
          </p>
        )}

        <div class="ev-preview" aria-hidden="true">
          <span class="ev-preview-title" data-preview-title>
            Your event
          </span>
          <span class="ev-preview-when" data-preview-when>
            Pick a date and time
          </span>
        </div>

        <div class="card stack">
          <label class="field">
            What's happening?
            <input
              type="text"
              name="title"
              required
              maxlength="80"
              placeholder="Rooftop picnic, games night, a long walk…"
              data-title
            />
          </label>
          <div class="row-3">
            <label class="field">
              Date
              <input type="date" name="date" required min={today} value={addDays(today, 7)} data-date />
            </label>
            <label class="field">
              Starts
              <input type="time" name="start" required value="19:00" data-start />
            </label>
            <label class="field">
              Ends
              <input type="time" name="end" required value="21:00" data-end />
            </label>
          </div>
          <label class="field">
            Where
            <input type="text" name="location" maxlength="120" placeholder="Address, park, or 'my place'" />
          </label>
          <label class="field">
            Details
            <textarea name="details" rows="4" maxlength="1000" placeholder="What to bring, how to find it, anything people should know"></textarea>
          </label>
          <p class="muted fine">Times are in {person.timezone}.</p>
        </div>

        <fieldset class="card stack visibility">
          <legend>Who can see it?</legend>
          <div class="choice-row">
            <label class="choice">
              <input type="radio" name="visibility" value="public" checked />
              <span class="choice-body">
                <span class="choice-title">
                  <Icon name="globe" size={18} /> Public
                </span>
                <span class="muted">Anyone with the link can see it and RSVP. Listed on Explore.</span>
              </span>
            </label>
            <label class="choice">
              <input type="radio" name="visibility" value="private" />
              <span class="choice-body">
                <span class="choice-title">
                  <Icon name="lock" size={18} /> Private
                </span>
                <span class="muted">Only you and the people you invite can see it.</span>
              </span>
            </label>
          </div>
        </fieldset>

        <fieldset class="card stack">
          <legend>Invite</legend>
          {friends.length === 0 && groups.length === 0 ? (
            <p class="muted">
              Add <a href="/friends">friends</a> or join a group to invite people. You can always
              share the link instead.
            </p>
          ) : (
            <>
              {friends.length > 0 && (
                <div>
                  <h2 class="list-label">Friends</h2>
                  <div class="invite-grid">
                    {friends.map((f) => (
                      <label class="invite-chip">
                        <input type="checkbox" name="invite" value={f.id} />
                        <span class="avatar" style={`--hue: ${hue(f.name)}`} aria-hidden="true">
                          {initials(f.name)}
                        </span>
                        {f.name}
                      </label>
                    ))}
                  </div>
                </div>
              )}
              {groups.length > 0 && (
                <div>
                  <h2 class="list-label">Whole groups</h2>
                  <div class="invite-grid">
                    {groups.map(({ group }) => (
                      <label class="invite-chip">
                        <input type="checkbox" name="inviteGroup" value={group.id} />
                        <Icon name="users" size={18} />
                        {group.name}
                      </label>
                    ))}
                  </div>
                </div>
              )}
            </>
          )}
        </fieldset>

        <div class="save-bar">
          <span role="status" class="muted">Ready when you are</span>
          <button type="submit" class="button">
            <Icon name="sparkles" size={18} /> Create event
          </button>
        </div>
      </form>
    )
  }
</Base>

<script>
  // A live preview of the event card as you type.
  const title = document.querySelector<HTMLInputElement>("[data-title]");
  const date = document.querySelector<HTMLInputElement>("[data-date]");
  const start = document.querySelector<HTMLInputElement>("[data-start]");
  const end = document.querySelector<HTMLInputElement>("[data-end]");
  const previewTitle = document.querySelector<HTMLElement>("[data-preview-title]");
  const previewWhen = document.querySelector<HTMLElement>("[data-preview-when]");
  function update() {
    if (previewTitle) previewTitle.textContent = title?.value.trim() || "Your event";
    if (previewWhen && date?.value) {
      const day = new Date(`${date.value}T00:00:00`).toLocaleDateString(undefined, {
        weekday: "long",
        day: "numeric",
        month: "long",
      });
      previewWhen.textContent = `${day} · ${start?.value ?? ""}–${end?.value ?? ""}`;
    }
  }
  for (const input of [title, date, start, end]) input?.addEventListener("input", update);
  update();
</script>
