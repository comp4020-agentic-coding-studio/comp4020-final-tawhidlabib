---
import EventForm from "../../components/EventForm.astro";
import Onboard from "../../components/Onboard.astro";
import Base from "../../layouts/Base.astro";
import { friendsOf } from "../../lib/friends";
import { ERRORS } from "../../lib/forms";
import { groupsFor } from "../../lib/identity";
import { DEFAULT_TIMEZONE, todayIn } from "../../lib/time";

const person = Astro.locals.person;
const error = ERRORS[Astro.url.searchParams.get("error") ?? ""];
const friends = person ? friendsOf(person.id) : [];
const groups = person ? groupsFor(person, Astro.request.headers.get("cookie")) : [];
const today = todayIn(person?.timezone ?? DEFAULT_TIMEZONE);
---

<Base title="Create an event · Hangout">
  <div class="page-head">
    <div>
      <span class="kicker">Host something</span>
      <h1>Create an event</h1>
    </div>
  </div>

  {
    !person ? (
      <Onboard back="/events/new" lead="Make your profile, then host your first event." />
    ) : (
      <EventForm
        action="/api/events"
        today={today}
        timezone={person.timezone}
        error={error}
        friends={friends}
        groups={groups}
        submitLabel="Create event"
      />
    )
  }
</Base>
