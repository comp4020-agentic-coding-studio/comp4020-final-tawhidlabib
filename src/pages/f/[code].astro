---
import Avatar from "../../components/Avatar.astro";
import Icon from "../../components/Icon.astro";
import Onboard from "../../components/Onboard.astro";
import Base from "../../layouts/Base.astro";
import { hue, initials } from "../../lib/avatar";
import { hasBlocked } from "../../lib/blocks";
import { sharedGroups } from "../../lib/circle";
import { relationship } from "../../lib/friends";
import { personByCode } from "../../lib/people";

// Someone's friend link. Opening it only shows who they are; adding them is a
// button (a POST), so a link preview can't send a request on anyone's behalf.
const code = Astro.params.code ?? "";
const them = personByCode(code);
if (!them) Astro.response.status = 404;
const me = Astro.locals.person;
const tie = them && me ? relationship(me.id, them.id) : "none";
const blocked = !!them && !!me && hasBlocked(me.id, them.id);
const inCommon = them && me ? (sharedGroups(me, Astro.request.headers.get("cookie")).get(them.id) ?? []) : [];
---

<Base title={them ? `Add ${them.name} · Hangout` : "Link not found · Hangout"}>
  <div class="narrow start-card join-card stack">
    {
      !them ? (
        <>
          <div class="icon-bubble">
            <Icon name="link" size={22} />
          </div>
          <h1>This friend link doesn't work</h1>
          <p class="muted">Ask for their link again: it may have been copied only partly.</p>
          <a class="button" href="/friends">
            Go to your friends
          </a>
        </>
      ) : (
        <>
          <Avatar name={them.name} photo={them.avatarPhoto} emoji={them.avatarEmoji} class="xl" />
          {them.bio && <p class="bio">“{them.bio}”</p>}
          {inCommon.length > 0 && <p class="muted fine">In {inCommon.join(", ")} with you</p>}
          {tie === "self" ? (
            <>
              <h1>This is your friend link</h1>
              <p class="muted">Send it to people so they can add you.</p>
              <a class="button" href="/friends">
                See your friends
              </a>
            </>
          ) : tie === "friends" ? (
            <>
              <h1>You and {them.name} are friends</h1>
              <a class="button" href="/friends">
                See your friends
              </a>
            </>
          ) : tie === "sent" ? (
            <>
              <h1>Request sent to {them.name}</h1>
              <p class="muted">You'll be friends as soon as they accept.</p>
              <a class="button ghost" href="/friends">
                See your friends
              </a>
            </>
          ) : tie === "received" ? (
            <>
              <h1>{them.name} wants to be friends</h1>
              <form method="post" action="/api/friends/respond">
                <input type="hidden" name="person" value={them.id} />
                <input type="hidden" name="back" value="/friends" />
                <button type="submit" name="action" value="accept" class="button large">
                  <Icon name="check" /> Accept
                </button>
              </form>
            </>
          ) : me ? (
            <>
              <div>
                <span class="pill">
                  <Icon name="heart" size={14} /> Friend link
                </span>
                <h1>Add {them.name} as a friend?</h1>
                <p class="muted">
                  They'll get a request. Once they accept, you can invite each other to events.
                </p>
              </div>
              <form method="post" action="/api/friends">
                <input type="hidden" name="code" value={code} />
                <input type="hidden" name="back" value="/friends" />
                <button type="submit" class="button large">
                  <Icon name="userPlus" /> Add {them.name}
                </button>
              </form>
            </>
          ) : (
            <>
              <h1>{them.name} wants to be friends on Hangout</h1>
              <Onboard
                back={`/f/${code}`}
                title="First, what should they call you?"
                lead={`Make your profile, then add ${them.name}.`}
              />
            </>
          )}
        </>
      )
    }
    {
      them && me && tie !== "self" && (
        <form method="post" action="/api/blocks" class="block-form">
          <input type="hidden" name="code" value={code} />
          <input type="hidden" name="action" value={blocked ? "unblock" : "block"} />
          {blocked && <p class="muted">You've blocked {them.name}. They can't reach you here.</p>}
          <button type="submit" class="link-button">
            {blocked ? `Unblock ${them.name}` : `Block ${them.name}`}
          </button>
        </form>
      )
    }
  </div>
</Base>
